{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Audio Studio",
  "version": "0.1.0",
  "identifier": "com.openaudiostudio.app",
  "build": {
    "beforeDevCommand": "pnpm worker:sync && pnpm ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm worker:sync && pnpm ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Open Audio Studio",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Run speech AI models locally.",
    "longDescription": "Open Audio Studio runs OpenAI Whisper and other open speech models fully on your machine, predicts performance before download, and runs many jobs in parallel safely.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/oas-worker"]
  }
}
