{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynthSpeech",
  "version": "0.1.0",
  "identifier": "com.synthspeech.app",
  "build": {
    "beforeDevCommand": "pnpm worker:sync && pnpm ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm worker:sync && pnpm ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SynthSpeech",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Run speech AI models locally.",
    "longDescription": "SynthSpeech runs OpenAI Whisper and other open speech models fully on your machine, predicts performance before download, and runs many jobs in parallel safely.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/oas-worker"
    ],
    "resources": [
      "resources/speed-test-clip.wav"
    ],
    "copyright": "Copyright (c) SynthSpeech contributors",
    "license": "MIT",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
